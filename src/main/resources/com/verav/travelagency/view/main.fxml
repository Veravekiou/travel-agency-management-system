<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.verav.travelagency.controller.MainController">

    <top>
        <Label styleClass="title-label" text="Travel Agency Management System" />
    </top>

    <left>
        <VBox prefHeight="423.0" prefWidth="200.0" style="-fx-background-color: #4d1c7e;" styleClass="nav-menu">
            <Button onAction="#loadHome" styleClass="nav-button" text="Home" />
            <Button onAction="#loadcustomers" styleClass="nav-button" text="Customers" />
            <Button onAction="#loadtrips" styleClass="nav-button" text="Trips" />
            <Button onAction="#loadbookings" styleClass="nav-button" text="Bookings" />


      
              </VBox>
    </left>

    <center>
        <AnchorPane fx:id="moduleRoot" prefHeight="723.0" prefWidth="632.0" styleClass="content-pane">
            <children>
                <!-- Initial dashboard view -->
                <fx:include fx:id="contentLoader" source="home.fxml" />
            <ScrollPane layoutX="39.0" layoutY="387.0" prefHeight="112.0" prefWidth="582.0">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="200.0" prefWidth="200.0" />
              </content>
            </ScrollPane>
            <AreaChart layoutX="14.0" layoutY="110.0" prefHeight="243.0" prefWidth="280.0">
              <xAxis>
                <CategoryAxis side="BOTTOM" />
              </xAxis>
              <yAxis>
                <NumberAxis side="LEFT" />
              </yAxis>
            </AreaChart>
            <PieChart layoutX="328.0" layoutY="125.0" prefHeight="207.0" prefWidth="292.0" />
            </children>
        </AnchorPane>
    </center>

    <ListView fx:id="tripList" layoutX="20" layoutY="20" prefHeight="200" prefWidth="300" />

</BorderPane>
